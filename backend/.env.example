# Copy to .env (it is gitignored) and edit. Only this file is committed, and it holds placeholders only:
# never put a real key, password or token in it.
#
# An empty value means "not set" and the feature stays off. A commented-out line shows an optional setting
# with its default. Names are case-insensitive; every setting is read once, through app/config.py.
#
# The values that are active below are DEVELOPMENT defaults. On a real server, set (see DEPLOYMENT.md):
#   APP_ENV=production        switches off tracebacks and the /docs, /redoc and /openapi.json pages, and turns on
#                             start-up warnings about the settings below
#   DATABASE_URL              PostgreSQL, postgresql+psycopg://..., never SQLite. Run `alembic upgrade head` first
#   COOKIE_SECURE=true        the session cookie only travels over https
#   AUTH_REQUIRED=true        never false on a server other people can reach
#   PUBLIC_BASE_URL and CORS_ORIGINS   the frontend's https origin
#   TRUSTED_PROXY_HOPS        how many reverse proxies sit in front of this process (rate limits depend on it)
#   GOOGLE_CLIENT_ID          if Google sign-in is offered
#   SIGNUP_ENABLED            decide it on purpose (see below)
# Run ONE instance with ONE worker: calls, rate limits and background tasks live in this process's memory.

# --- Application ---
APP_NAME=Real-Time Voice Agent
# development | staging | production
APP_ENV=development
# Tracebacks in the browser for unhandled errors. Ignored when APP_ENV=production.
DEBUG=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (required) ---
# PostgreSQL through psycopg 3. The scheme must be exactly postgresql+psycopg:// (hosts often hand out postgres://
# or postgresql://, which select a driver that is not installed: rewrite the prefix). URL-encode special characters
# in the password (@ becomes %40). The server never creates the schema; Alembic does:  alembic upgrade head
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/voice_agent
# Local development only, if you have no PostgreSQL: a SQLite file. Never in production (hosting disks are usually
# wiped on every deploy, and one file cannot be shared between instances).
# DATABASE_URL=sqlite:///./voice_agent.db

# --- LLM ---
# The key stays on the server and is never sent to the browser. Create one in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 0 = no thinking (fastest first word, right for voice); -1 = let the model decide.
# Some models cannot turn thinking off: set -1 for those.
GEMINI_THINKING_BUDGET=0
BRAIN_TIMEOUT_SECONDS=30

# --- Sign-in (operator console) ---
# On by default. Create the first user with:  python -m app.cli create-user you@example.com --role admin
# Set to false only for local development.
AUTH_REQUIRED=true
# Self-service sign-up: anyone may create an account, which gets a workspace of its own and the operator role.
# There is NO email verification, and Google sign-in matches an existing account by verified email, so an account
# created with someone else's address can be picked up by them later. In production either set false (create
# users with the CLI) or add an email-verification / account-linking strategy before leaving it open. It also
# lets strangers place phone calls once telephony is configured.
SIGNUP_ENABLED=true
# Set true whenever the site is served over https (always, in production). The cookie is also HttpOnly and
# SameSite=Lax: keep the frontend and this API the same origin from the browser's point of view (see DEPLOYMENT.md).
COOKIE_SECURE=false
# Google sign-in. The OAuth "Web application" client ID from Google Cloud Console (APIs & Services > Credentials).
# It is public, not a secret, and must be the same value as the frontend's VITE_GOOGLE_CLIENT_ID. The frontend's
# origin must be listed under "Authorized JavaScript origins" there. No client secret and no redirect URI are used.
# Empty = Google sign-in is off (the endpoint answers 503). Google never creates accounts: it signs in an existing
# user with the same verified email.
GOOGLE_CLIENT_ID=
# Hours a sign-in lasts.
# AUTH_SESSION_HOURS=12
# Behind a reverse proxy: how many proxies to trust for X-Forwarded-For (0 = none, use the socket address).
# Set it to the number of proxies in YOUR hosting chain. With 0 behind a proxy every client shares the proxy's
# address (and one rate-limit bucket); too high lets clients choose their own address. Verify it on the real host.
# TRUSTED_PROXY_HOPS=0
# Origins allowed to make signed-in writes and to call this API from a browser (the frontend's address). A JSON
# list of exact origins: scheme + host, no path, no trailing slash. Never "*". PUBLIC_BASE_URL's origin is allowed too.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Outbound calling ---
# The business API (/api/call-jobs) stays closed until this is set. Use a long random value.
VOICE_AGENT_API_KEY=
# Signs result callbacks. Defaults to the API key.
# VOICE_AGENT_WEBHOOK_SECRET=
# Where callees open their answer link, and an allowed origin for signed-in writes: the frontend's public address.
PUBLIC_BASE_URL=http://localhost:5173
# Development only: allow result callbacks to localhost / private addresses.
# ALLOW_PRIVATE_CALLBACKS=true
# CALLBACK_ATTEMPTS=3
# CALLBACK_BACKOFF_SECONDS=2
# Seconds between sweeps that end ringing calls nobody answered.
# SWEEP_INTERVAL_SECONDS=5

# --- Phone calls (Twilio carries the call, Deepgram hears and speaks) ---
# They switch on only when ALL FIVE of these are set; otherwise the server runs without telephony.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 form.
TWILIO_FROM_NUMBER=
# Where Twilio reaches THIS server over the internet: an https address with no trailing slash. The audio
# WebSocket address (wss) is derived from it, and Twilio's webhook signatures are checked against it exactly.
PUBLIC_API_URL=
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Silence, in ms, before Deepgram decides the caller has finished a sentence.
# DEEPGRAM_ENDPOINTING_MS=400
# DEEPGRAM_UTTERANCE_END_MS=1000
# The caller must say this many words over the agent to cut it off.
# BARGE_IN_MIN_WORDS=2
# Off by default: caller ID proves nothing, so an open phone line would hand demo data to anyone who rings.
# TWILIO_INBOUND_ENABLED=false
# TWILIO_INBOUND_PROFILE=bank

# --- Workflow scheduler ---
# Every interval it runs the active workflows and then places the calls that are due. OFF by default:
# turning it on lets this process ring people on its own. Enable it only where that is intended.
# WORKFLOW_SCHEDULER_ENABLED=false
# Seconds between ticks. Never faster than 60.
# WORKFLOW_SCHEDULER_INTERVAL_SECONDS=60
# Active workflows run per tick, and scheduled jobs looked at per tick.
# WORKFLOW_SCHEDULER_WORKFLOW_LIMIT=100
# WORKFLOW_SCHEDULER_DISPATCH_LIMIT=100

# --- Capacity and rate limits ---
# Calls held in memory at once, and how long an idle one is kept, in seconds.
# MAX_SESSIONS=200
# SESSION_TTL_SECONDS=3600
# CALL_IDLE_TIMEOUT_SECONDS=120
# Requests per minute. The counters are in this process's memory, which is one more reason to run one instance.
# LIMIT_LOGIN_PER_IP=10
# LIMIT_LOGIN_PER_EMAIL=5
# LIMIT_SIGNUP_PER_IP=5
# LIMIT_CALLEE_PER_IP=30
# LIMIT_JOBS_PER_PRINCIPAL=60
# LIMIT_CALLS_PER_USER=20
# LIMIT_TURNS_PER_CALL=30

# --- Voice runtime ---
# Which runtime conducts a phone call, chosen once when the call starts. "legacy" is the one in production use.
# "pipecat" is opt-in and needs requirements-pipecat.txt; if it is asked for but not installed (or is not the
# pinned version) the call is conducted by the legacy runtime and a warning is logged.
# VOICE_RUNTIME=legacy
# With VOICE_RUNTIME=pipecat: only these agents' calls (comma-separated agent ids) use it. Empty = every call.
# VOICE_RUNTIME_PIPECAT_AGENT_IDS=
# Experimental, and only with VOICE_RUNTIME=pipecat. Values: off | observe | interrupt.
#   off (default)  creates no VAD.
#   observe        runs Pipecat's Silero VAD alongside a call and records when speech started and stopped. It does NOT
#                  affect turn detection or interruptions: Deepgram still ends each utterance.
#   interrupt      as observe, and also passes VAD's speech-started signal to the session as an inert diagnostic hint:
#                  it never itself interrupts, clears playback or starts a turn.
# If the VAD cannot be created the call is conducted by the legacy runtime.
# VOICE_PIPECAT_VAD=off
# Experimental, and only with VOICE_RUNTIME=pipecat. "compat" (default) is the existing Deepgram recognizer, unchanged.
# "native" is Pipecat's own Deepgram STT, configured to match it (needs deepgram-sdk, in requirements-pipecat.txt); if it
# cannot be built the call uses "compat" instead, before any audio. Values: compat | native.
# VOICE_PIPECAT_STT=compat
